# ── Application ────────────────────────────────────────────────
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
LOG_LEVEL=INFO

# ── GitHub ─────────────────────────────────────────────────────
GITHUB_WEBHOOK_SECRET=your_webhook_secret_here
GITHUB_APP_ID=your_github_app_id
GITHUB_APP_PRIVATE_KEY_PATH=./secrets/github-app.pem
GITHUB_TOKEN=ghp_your_personal_access_token   # fallback for dev

# ── Anthropic ──────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-your_api_key_here

# ── Database ───────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://macrv:macrv@localhost:5432/macrv
DATABASE_URL_SYNC=postgresql://macrv:macrv@localhost:5432/macrv

# ── Redis / Celery ─────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# ── Email ──────────────────────────────────────────────────────
SENDGRID_API_KEY=SG.your_key_here
EMAIL_FROM=reviews@yourdomain.com
EMAIL_FROM_NAME=Code Review Bot

# ── Notifications (optional) ───────────────────────────────────
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/...

# ── Ticket providers (optional) ────────────────────────────────
JIRA_URL=https://yourorg.atlassian.net
JIRA_EMAIL=you@yourorg.com
JIRA_TOKEN=your_jira_api_token
JIRA_PROJECT_KEY=ENG

LINEAR_API_KEY=lin_api_your_key
LINEAR_TEAM_ID=your_team_id

# ── Observability ──────────────────────────────────────────────
WANDB_API_KEY=your_wandb_key
WEAVE_PROJECT=macrv

# ── Models ─────────────────────────────────────────────────────
ORCHESTRATOR_MODEL=claude-opus-5-5
WORKER_MODEL=claude-sonnet-4-6
CLASSIFIER_MODEL=claude-haiku-5-5
